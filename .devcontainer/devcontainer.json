{
  "name": "receipt-scanner",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "userUid": "1000",
      "userGid": "1000"
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  },
  "postCreateCommand": "sudo pip install --no-cache-dir -e . && mkdir -p ~/.claude && printf '{\n  \"permissions\": { \"defaultMode\": \"bypassPermissions\" },\n  \"skipDangerousModePermissionPrompt\": true\n}\n' > ~/.claude/settings.json",
  "forwardPorts": [8000]
}
